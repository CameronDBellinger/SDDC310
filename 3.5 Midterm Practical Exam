$delete = false;

// Determine which button was clicked
if (isset($_POST['address_no'])) {

$addressNo = (int)$_POST['address_no'];

$add = isset($_POST['add']);
$edit = isset($_POST['edit']);
$update = isset($_POST['update']);
$delete = isset($_POST['delete']);
}

// ADD
if ($add) {

$firstName = mysqli_real_escape_string($conn, $_POST['first_name']);
$lastName = mysqli_real_escape_string($conn, $_POST['last_name']);
$street = mysqli_real_escape_string($conn, $_POST['street']);
$city = mysqli_real_escape_string($conn, $_POST['city']);
$state = mysqli_real_escape_string($conn, $_POST['state']);
$zip = (int)$_POST['zip'];

$query = "INSERT INTO personalinfo
(FirstName, LastName, Street, City, State, Zip)
VALUES
('$firstName', '$lastName', '$street', '$city', '$state', $zip)";

if (!mysqli_query($conn, $query)) {
die("Add error: " . mysqli_error($conn));
}

$addressNo = -1;
$firstName = "";
$lastName = "";
$street = "";
$city = "";
$state = "";
$zip = 0;
}

// EDIT
else if ($edit) {

$query = "SELECT * FROM personalinfo
WHERE AddressNo = $addressNo";

$result = mysqli_query($conn, $query);

if (!$result) {
die("Edit error: " . mysqli_error($conn));
}

$row = mysqli_fetch_assoc($result);

if ($row) {
$firstName = $row["FirstName"];
$lastName = $row["LastName"];
$street = $row["Street"];
$city = $row["City"];
$state = $row["State"];
$zip = $row["Zip"];
}
}

// UPDATE
else if ($update) {

$firstName = mysqli_real_escape_string($conn, $_POST['first_name']);
$lastName = mysqli_real_escape_string($conn, $_POST['last_name']);
$street = mysqli_real_escape_string($conn, $_POST['street']);
$city = mysqli_real_escape_string($conn, $_POST['city']);
$state = mysqli_real_escape_string($conn, $_POST['state']);
$zip = (int)$_POST['zip'];

$query = "UPDATE personalinfo SET
FirstName = '$firstName',
LastName = '$lastName',
Street = '$street',
City = '$city',
State = '$state',
Zip = $zip
WHERE AddressNo = $addressNo";

if (!mysqli_query($conn, $query)) {
die("Update error: " . mysqli_error($conn));
}

$addressNo = -1;
$firstName = "";
$lastName = "";
$street = "";
$city = "";
$state = "";
$zip = 0;
}

// DELETE
else if ($delete) {

$query = "DELETE FROM personalinfo
WHERE AddressNo = $addressNo";

if (!mysqli_query($conn, $query)) {
die("Delete error: " . mysqli_error($conn));
}

$addressNo = -1;
}

// Get all addresses
$query = "SELECT * FROM personalinfo ORDER BY AddressNo";

$result = mysqli_query($conn, $query);

if (!$result) {
die("Display error: " . mysqli_error($conn));
}
