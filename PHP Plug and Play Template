    <th>Last</th>
    <th>Email</th>
    <th>Favorite #</th>
    <th>Edit</th>
    <th>Delete</th>
</tr>

<?php while ($row = mysqli_fetch_assoc($result)): ?>
<tr>
    <td><?= $row["RecordID"] ?></td>
    <td><?= $row["FirstName"] ?></td>
    <td><?= $row["LastName"] ?></td>
    <td><?= $row["Email"] ?></td>
    <td><?= $row["FavoriteNum"] ?></td>

    <td>
        <form method="POST">
            <input type="hidden" name="record_id" value="<?= $row["RecordID"] ?>">
            <input class="button" type="submit" name="edit" value="Edit">
        </form>
    </td>

    <td>
        <form method="POST">
            <input type="hidden" name="record_id" value="<?= $row["RecordID"] ?>">
            <input class="button" type="submit" name="delete" value="Delete">
        </form>
    </td>
</tr>
<?php endwhile; ?>
</table>

<div class="form-section">
<h2><?= $edit ? "Update Record" : "Add Record" ?></h2>

<form method="POST">

<input type="hidden" name="record_id" value="<?= $recordID ?>">

<label>First Name:</label><br>
<input type="text" name="first_name" value="<?= $firstName ?>" required><br>

<label>Last Name:</label><br>
<input type="text" name="last_name" value="<?= $lastName ?>" required><br>

<label>Email:</label><br>
<input type="email" name="email" value="<?= $email ?>" required><br>

<label>Favorite Number:</label><br>
<input type="number" name="fav_num" value="<?= $favNum ?>" required><br><br>

<?php if ($edit): ?>
    <input class="button" type="submit" name="update" value="Update">
<?php else: ?>
    <input class="button" type="submit" name="add" value="Add">
<?php endif; ?>

</form>
</div>

</body>
</html>
